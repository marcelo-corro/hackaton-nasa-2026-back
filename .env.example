# Copiar como .env y completar. Nunca subir .env al repo.

# Carpeta con los CSV anuales de FIRMS. Vacío = data/raw/firms, que llena scripts/01_descargar_datos.py
FIRMS_RAW_DIR=

# Llave gratis de FIRMS para los focos de 2026 (casi tiempo real)
# Se pide en https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Credenciales de Meteomatics (Global Offer de Space Apps; se piden por formulario)
METEOMATICS_USER=
METEOMATICS_PASSWORD=

# Carpeta donde se escriben los JSON para el front (por defecto ./public)
PUBLIC_DIR=

# Clon local del repo público de datos (github.com/marcelo-corro/aivital-incendios-datos), para publicar
DATOS_REPO_DIR=
